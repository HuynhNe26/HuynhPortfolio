# Copy to backend/.env. MongoDB needs a connection URI, not an API key.
MONGODB_URI=
MONGODB_DB=nh_huynh
APP_URL=http://localhost:3000
PORT=4000
HOST=127.0.0.1
RESEND_API_KEY=
CONTACT_FROM=
CONTACT_TO=
# Set NODE_ENV=production on the production host to enable Secure cookies.
# Used only by npm run admin:create; remove the password after provisioning.
ADMIN_EMAIL=
ADMIN_PASSWORD=
