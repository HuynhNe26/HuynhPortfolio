# ==============================================================================
# NH HUYNH PORTFOLIO — BACKEND CONFIGURATION
# ==============================================================================

# PostgreSQL (Neon Serverless) Connection URI
# 1. Sign up / log in to https://console.neon.tech
# 2. In your Project Dashboard -> "Connection Details" -> select "Pooled connection"
# 3. Copy your connection string and paste it below:
# Format: postgresql://[user]:[password]@[endpoint]-pooler.[region].aws.neon.tech/[dbname]?sslmode=require
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-sample-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Optional fallback alias (Vercel / Neon integration)
POSTGRES_URL=

# Server Configuration
PORT=4000
HOST=127.0.0.1
APP_URL=http://localhost:3000

# Transactional Email Service (Resend)
# Get your API key at https://resend.com/api-keys
RESEND_API_KEY=
CONTACT_FROM=
CONTACT_TO=nguyenhoanghuynh.vn@gmail.com

# Admin Account Provisioning (Used once by: npm run admin:create)
ADMIN_EMAIL=admin@nhhuynh.dev
ADMIN_PASSWORD=
