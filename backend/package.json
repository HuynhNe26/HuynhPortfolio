{
  "name": "@nh-huynh/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --watch-path=src --env-file-if-exists=.env --import tsx src/server.ts",
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/src/server.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "db:setup": "node --import tsx --env-file-if-exists=.env scripts/setup-db.ts",
    "db:seed": "node --import tsx --env-file-if-exists=.env scripts/seed.ts",
    "admin:create": "node --import tsx --env-file-if-exists=.env scripts/create-admin.ts"
  },
  "dependencies": {
    "mongodb": "^7.0.0",
    "pg": "^8.23.1",
    "resend": "^6.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1"
  }
}
